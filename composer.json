{
    "name": "pms-nz/object-translation-bundle",
    "description": "Translate entities using Doctrine listeners",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PmsNz\\ObjectTranslationBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PmsNz\\ObjectTranslationBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Max Scott"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/translation": "^7.4|^8.0",
        "doctrine/doctrine-bundle": "^2.18|^3.0",
        "doctrine/orm": "^3.5",
        "symfony/property-access": "^7.4|^8.0",
        "symfony/monolog-bundle": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/phpunit-bridge": "^7.4|^8.0",
        "zenstruck/foundry": "^2.8",
        "php-cs-fixer/shim": "^3.92",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
